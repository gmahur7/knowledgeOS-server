# Copy this file to .env and adjust values for your local environment.
# .env is gitignored; .env.example is committed as the documented template.

# ── Postgres (pgvector) ─────────────────────────────────────────────
POSTGRES_USER=osuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=osdb
POSTGRES_PORT=5432

# ── Redis ───────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Ollama ──────────────────────────────────────────────────────────
OLLAMA_PORT=11434
